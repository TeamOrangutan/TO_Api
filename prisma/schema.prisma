model ORDENES {
  orden_pk   Int          @id @default(autoincrement())
  orderId    String       @unique
  usuario_fk Int
  estado     String
  payerEmail String?
  payerName  String?
  total      Float
  moneda     String?
  createdAt  DateTime     @default(now())
  usuario    USUARIO      @relation(fields: [usuario_fk], references: [usuario_pk])
  ordenItem  ORDEN_ITEM[]
  factura    Factura?     @relation("OrdenFactura")
}

model ORDEN_ITEM {
  orden_item_pk       Int           @id @default(autoincrement())
  orden_fk            Int
  producto_fk         Int
  talla_fk            Int?
  cantidad            Int
  precio_unitario_usd Float
  subtotal_usd        Float
  ordenes             ORDENES       @relation(fields: [orden_fk], references: [orden_pk])
  producto            PRODUCTOS     @relation(fields: [producto_fk], references: [producto_pk])
  talla               TALLA?        @relation(fields: [talla_fk], references: [talla_pk])
  facItems            FacturaItem[]
}

model Factura {
  factura_pk    Int           @id @default(autoincrement())
  orden_id      Int           @unique
  orden_fk      ORDENES       @relation("OrdenFactura", fields: [orden_id], references: [orden_pk])
  fecha         DateTime      @default(now())
  nombreCliente String
  direccion     String?
  telefono      String?
  metodoPago    String?
  total         Float
  folio         String        @unique
  facItems      FacturaItem[]
}

model FacturaItem {
  factura_item_pk Int        @id @default(autoincrement())
  factura_fk      Factura    @relation(fields: [factura_id], references: [factura_pk])
  factura_id      Int
  orden_item_id   Int
  orden_item_fk   ORDEN_ITEM @relation(fields: [orden_item_id], references: [orden_item_pk])
}

