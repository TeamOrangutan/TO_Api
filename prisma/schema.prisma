generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model Product {
  product_pk Int @id @default(autoincrement())
  name String 
  createdAt DateTime @default(now())
  category_fk Int
  category Category @relation(fields: [category_fk], references: [category_pk])
}

model Category {
  category_pk Int @id @default(autoincrement())
  description  String
  products Product[]
}
