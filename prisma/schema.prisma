generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Descripcion {
  descripcion_pk Int      @id @default(autoincrement())
  descripcion    String
  producto_fk    Int
  Producto       Producto @relation(fields: [producto_fk], references: [producto_pk])
}

model Imagen {
  imagen_pk   Int      @id @default(autoincrement())
  imagen_url  String
  producto_fk Int
  Producto    Producto @relation(fields: [producto_fk], references: [producto_pk])
}

model Inventario {
  inventario_pk Int      @id @default(autoincrement())
  producto_fk   Int
  stock         Int
  Producto      Producto @relation(fields: [producto_fk], references: [producto_pk])
}

model Producto {
  producto_pk Int           @id @default(autoincrement())
  createdAt   DateTime
  descripcion String
  estado      Boolean
  nombre      String
  precio      Float
  Descripcion Descripcion[]
  Imagen      Imagen[]
  Inventario  Inventario[]
  Registro    Registro[]
}

model Registro {
  registro_pk Int      @id @default(autoincrement())
  fecha       DateTime
  producto_fk Int
  usuario_fk  Int
  Producto    Producto @relation(fields: [producto_fk], references: [producto_pk])
  Usuario     Usuario  @relation(fields: [usuario_fk], references: [user_pk])
}

model Rol {
  rol_pk      Int       @id @default(autoincrement())
  descripcion String
  Usuario     Usuario[]
}

model Usuario {
  user_pk    Int        @id @default(autoincrement())
  contrasena String
  correo     String     @unique
  nombre     String
  rol_fk     Int
  Registro   Registro[]
  Rol        Rol        @relation(fields: [rol_fk], references: [rol_pk])
}
