datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model ROL {
  rol_pk      Int       @id @default(autoincrement())
  descripcion String
  usuarios    USUARIO[] // Relación inversa con USUARIO
}

model USUARIO {
  usuario_pk        Int       @id @default(autoincrement())
  correo            String    @unique
  contrasena        String
  telefono          String?   
  passwordChangedAt DateTime?
  rol_fk            Int
  rol               ROL       @relation(fields: [rol_fk], references: [rol_pk])
  resetToken        String? // token de recuperación
  resetTokenExpiry  DateTime? // expiración del token
  estado            String    @default("Activo")
  ultimoAcceso      DateTime?
  persona           PERSONA?
  carrito           CARRITO?
  ordenes           ORDENES[]
  reportesQuincenales REPORTE_QUINCENAL[]
}

model PERSONA {
  persona_pk   Int     @id @default(autoincrement())
  nombres      String
  apellidos    String
  direccion    String
  usuario_fk   Int     @unique
  usuario      USUARIO @relation(fields: [usuario_fk], references: [usuario_pk])
  // fPagoClientes FPago_CLIENTE[]
  imagenPerfil String?
}

model CARRITO {
  carrito_pk Int            @id @default(autoincrement())
  usuario_fk Int?           @unique // Relación opcional con USUARIO (permitiendo carritos para usuarios no registrados)
  usuario    USUARIO?       @relation(fields: [usuario_fk], references: [usuario_pk]) // Relación opcional
  items      CARRITO_ITEM[] // Relación con los items del carrito
  total      Decimal        @default(0) // Total del carrito
}

model CARRITO_ITEM {
  carritoItem_pk Int       @id @default(autoincrement())
  carrito_fk     Int
  producto_fk    Int
  cantidad       Int
  talla_fk       Int?
  carrito        CARRITO   @relation(fields: [carrito_fk], references: [carrito_pk])
  producto       PRODUCTOS @relation(fields: [producto_fk], references: [producto_pk], onDelete: Cascade)
  talla          TALLA?    @relation(fields: [talla_fk], references: [talla_pk])
}

