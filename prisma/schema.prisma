model PRODUCTOS {
  producto_pk       Int                @id @default(autoincrement())
  nombre            String
  precioVenta       Decimal
  precioFabricacion Decimal            @default(0.0)
  descripcion       String
  estado            String             @default("disponible")
  tallas            TALLA[] // Relación con las tallas
  inventarios       INVENTARIO[]
  registros         REGISTRO[]
  serigrafiados     PRO_SERIGRAFIADO[]
  posters           PRO_POSTERS[]
  impresiones       PRO_IMPRESION[]
  imagenes          IMAGEN[]
  carritoItems      CARRITO_ITEM[] // Relación inversa con CARRITO_ITEM
  ordenItem         ORDEN_ITEM[]
}


model REPORTE_QUINCENAL {
  reporte_pk           Int      @id @default(autoincrement())
  codigo               String   @unique   
  fecha_generacion     DateTime @default(now())
  desde                DateTime 
  hasta                DateTime
  usuario_fk           Int?    
  usuario              USUARIO? @relation(fields: [usuario_fk], references: [usuario_pk])

  totalVentas          Float
  productosVendidos    Int
  ordenesProcesadas    Int
  promedioDiario       Float

  ventasDiarias        VentaDiaria[]         
  productosAnalisis    ProductoAnalisis[]   
}

model VentaDiaria {
  ventaDiaria_pk Int      @id @default(autoincrement())
  fecha          DateTime
  totalVentas    Float
  reporte_fk     Int
  reporte        REPORTE_QUINCENAL @relation(fields: [reporte_fk], references: [reporte_pk])
}

model ProductoAnalisis {
  productoAnalisis_pk Int    @id @default(autoincrement())
  nombreProducto       String
  cantidadVendida      Int
  montoTotal           Float
  porcentaje          Float
  reporte_fk           Int
  reporte              REPORTE_QUINCENAL @relation(fields: [reporte_fk], references: [reporte_pk])
}

model TALLA {
  talla_pk     Int            @id @default(autoincrement()) // Identificador único para la talla
  nombre       String // Nombre de la talla (ej. S, M, L, XL)
  cantidad     Int // Cantidad disponible para esta talla
  producto_fk  Int // Relación con el producto
  producto     PRODUCTOS      @relation(fields: [producto_fk], references: [producto_pk], onDelete: Cascade) // Relación con PRODUCTOS
  carritoItems CARRITO_ITEM[]
  ordenItem    ORDEN_ITEM[]
}

model IMAGEN {
  imagen_pk   Int       @id @default(autoincrement())
  producto_fk Int
  url         String // Ruta o URL de la imagen
  producto    PRODUCTOS @relation(fields: [producto_fk], references: [producto_pk], onDelete: Cascade) // Relación con el producto
}

model INVENTARIO {
  costes_pk    Int       @id @default(autoincrement())
  precioCompra Decimal
  stock        Int
  producto_fk  Int
  producto     PRODUCTOS @relation(fields: [producto_fk], references: [producto_pk], onDelete: Cascade)
}

model REGISTRO {
  registro_pk Int       @id @default(autoincrement())
  fecha       DateTime
  producto_fk Int
  producto    PRODUCTOS @relation(fields: [producto_fk], references: [producto_pk], onDelete: Cascade)
}

model MATERIAL {
  material_pk   Int                @id @default(autoincrement())
  nombre        String
  serigrafiados PRO_SERIGRAFIADO[] // Relación inversa con PRO_SERIGRAFIADO
}

model PRO_SERIGRAFIADO {
  serigrafiado_pk Int       @id @default(autoincrement())
  color           String
  tamano          String
  tipoTinta       String
  tipoProducto    String
  material_fk     Int
  producto_fk     Int
  material        MATERIAL  @relation(fields: [material_fk], references: [material_pk])
  producto        PRODUCTOS @relation(fields: [producto_fk], references: [producto_pk])
}

model PRO_POSTERS {
  poster_pk        Int       @id @default(autoincrement())
  dimensiones      String
  tipoImpresion    String
  acabado          String
  tipoPapel        String
  calidadImpresion String
  producto_fk      Int
  producto         PRODUCTOS @relation(fields: [producto_fk], references: [producto_pk])
}

model PRO_IMPRESION {
  impresion_pk  Int       @id @default(autoincrement())
  duracion      String
  resolucion    String
  nroFrames     String
  formato       String
  tipoAnimacion String
  producto_fk   Int
  producto      PRODUCTOS @relation(fields: [producto_fk], references: [producto_pk])
}
